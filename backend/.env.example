# ─── Gmail SMTP (required) ────────────────────────────────────────────────
# The Gmail address used to SEND the contact-form email.
# Can be the same as RECEIVER_EMAIL or a dedicated app account.
GMAIL_ADDRESS=tufailahmedsangrasi11@gmail.com

# Gmail App Password (NOT your normal account password).
# Generate at:  Google Account → Security → 2-Step Verification → App passwords
# Pick "Mail" + "Other" → name it "Portfolio Backend".
# Looks like:  abcd efgh ijkl mnop  (remove the spaces when you paste).
GMAIL_APP_PASSWORD=replace-with-16-char-app-password

# Where contact-form submissions get delivered.
RECEIVER_EMAIL=tufailahmedsangrasi11@gmail.com

# ─── CORS (required) ───────────────────────────────────────────────────────
# Comma-separated list of origins allowed to POST to /api/contact.
# Include your local Next.js dev URL and your production domain.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Server (optional) ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000